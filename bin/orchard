#!/bin/sh
# Orchard launcher: bypasses the flaky editable-install .pth that uv writes
# with the macOS hidden flag (which hardened site.py skips).
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$ROOT/.venv/bin/python" -m orchard "$@"
